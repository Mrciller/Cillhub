# Cillhub node behind Caddy: automatic HTTPS (Let's Encrypt) for CILLCORD_HOSTNAME.
{$CILLCORD_HOSTNAME} {
	# LiveKit signalling (only when the livekit profile runs)
	handle_path /livekit/* {
		reverse_proxy livekit:7880
	}
	# never pass a client-sent X-Real-IP through (the app reads X-Forwarded-For, this is for anything else that looks)
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
	}
}
