{
  "name": "cillhub",
  "productName": "Cillhub",
  "version": "2.2.2",
  "private": true,
  "description": "Cillhub desktop client",
  "homepage": "https://github.com/Mrciller/cillhub",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mrciller/cillhub.git",
    "directory": "desktop"
  },
  "author": "Pascal Oraze",
  "license": "AGPL-3.0-only",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node build/make-icons.js",
    "build:web": "node scripts/build-web.js",
    "test": "node --test test/*.test.js",
    "dist": "npm run icons && npm run build:web && node scripts/dist.js --x64 --win nsis --linux AppImage deb --publish never",
    "publish": "node scripts/publish.js"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.mrciller.cillhub",
    "productName": "Cillhub",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "web/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../selfhost/release-public-key.pem",
        "to": "release-public-key.pem"
      }
    ],
    "protocols": [
      {
        "name": "Cillhub",
        "schemes": [
          "cillcord",
          "cillhub"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cillhub",
      "artifactName": "Cillhub-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Cillhub ${version}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Network",
      "executableName": "cillhub",
      "maintainer": "Pascal Oraze",
      "synopsis": "Cillhub chat desktop client",
      "desktop": {
        "entry": {
          "Name": "Cillhub"
        }
      }
    },
    "appImage": {
      "artifactName": "Cillhub-${version}.AppImage"
    },
    "deb": {
      "artifactName": "cillhub_${version}_amd64.${ext}"
    },
    "copyright": "Copyright © Pascal Oraze"
  },
  "cillhubServer": "7.7.0"
}
